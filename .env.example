# ---------------------------------------------------------------------------
# AuxShare deployment configuration
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Public URL of the frontend. Used in share links and Spotify OAuth redirects.
FRONTEND_URL=https://aux-share.vercel.app

# Public URL of the backend API (no trailing slash).
BACKEND_URL=https://auxshare-api-40b1a9433585.herokuapp.com

# Must exactly match a Redirect URI registered in the Spotify developer
# dashboard, for example: https://auxshare-api-40b1a9433585.herokuapp.com/api/auth/callback
SPOTIFY_REDIRECT_URI=https://auxshare-api-40b1a9433585.herokuapp.com/api/auth/callback

# Set to production on deployed hosts. Production only allows FRONTEND_URL as a
# CORS origin; development also allows localhost.
ENVIRONMENT=production

# Set to true whenever the site is served over HTTPS.
COOKIE_SECURE=true

# Session cookie SameSite policy: lax (same-site), strict, or none. Use none
# only when the frontend and API are on different sites, with COOKIE_SECURE=true.
COOKIE_SAMESITE=none

# Host ports used by Docker Compose.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Spotify playlist extraction (Spotipy client credentials).
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Spotify OAuth and playlist export.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Music uses anonymous ytmusicapi access. No YouTube API key or OAuth
# credentials are required.

# Redis connection. Docker Compose overrides REDIS_HOST with "redis".
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Fernet key(s) used to encrypt Spotify OAuth tokens at rest. Required when
# ENVIRONMENT=production. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by prepending a new key: KEY_NEW,KEY_OLD
AUXSHARE_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------
# Frontend build (Vercel; Docker overrides VITE_API_URL for its nginx proxy)
# ---------------------------------------------------------------------------
# Canonical origin used by Open Graph, Twitter and JSON-LD metadata.
VITE_SITE_URL=https://aux-share.vercel.app

# Leave empty when nginx or Netlify proxies /api to the backend. Set it to the
# backend origin only when the browser calls the API directly.
VITE_API_URL=https://auxshare-api-40b1a9433585.herokuapp.com
