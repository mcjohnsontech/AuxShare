# Public URL used in generated share links and Spotify OAuth redirects.
# Register this URL plus /callback in the Spotify developer dashboard.
FRONTEND_URL=http://localhost:5173

# Host ports used by Docker Compose.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Spotify playlist extraction via Spotipy.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Spotify OAuth and playlist export.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Music uses anonymous ytmusicapi access in the current implementation.
# No YouTube API key or OAuth credentials are required.

# Redis connection. Docker Compose sets REDIS_HOST=redis automatically.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional Apple Music API credentials for the legacy MusicKit client.
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_TEAM_ID=
APPLE_KEY_ID=
