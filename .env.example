# Public URL used in generated share links.
FRONTEND_URL=http://localhost:5173
# Register this exact callback URL in the Spotify developer dashboard.
BACKEND_URL=http://127.0.0.1:8000
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
# Origin the browser uses to reach the API directly (must match the redirect
# URI host). Derived from SPOTIFY_REDIRECT_URI when unset.
# PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Host ports used by Docker Compose.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Spotify playlist extraction via Spotipy.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Spotify OAuth and playlist export.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Music uses anonymous ytmusicapi access in the current implementation.
# No YouTube API key or OAuth credentials are required.

# Redis connection. Docker Compose sets REDIS_HOST=redis automatically.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional Apple Music API credentials for the legacy MusicKit client.
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_TEAM_ID=
APPLE_KEY_ID=
